# Copy to .env.mn24-live; never commit real secrets.
# Use a random secret of at least 32 bytes. Must match the issuer used by MN24 auth.
MN24_APP_JWT_SECRET=replace-with-random-secret-at-least-32-characters
MN24_LIVE_DB=./data/mn24_live.sqlite3
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-before-use-000000000000000000000000
